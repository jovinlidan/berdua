# Copy to .env.local for local dev, and set the same vars in the Vercel dashboard.

# Client-visible public VAPID key (safe to expose). A default is baked into the app,
# but set this to override per-deploy.
VITE_VAPID_PUBLIC_KEY=

# OPTIONAL — the Map screen's name-search works WITHOUT this (it defaults to Photon, a keyless
# OpenStreetMap geocoder, no signup). Set a Mapbox PUBLIC token (pk.*) only to UPGRADE search to
# Mapbox's stronger Indonesia POI coverage. Safe to expose (public token; URL-restrict in prod).
# Note: Mapbox signup requires a work/org email domain. https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Server-only — NEVER expose to the client
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=a-random-secret-for-the-cron-endpoint

# Upstash Redis REST credentials (Upstash dashboard, or Vercel's Upstash integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
